{
	"name": "my-site",
	"repository": "github.com:n06Ar/MySite.git",
	"author": "NobuhitoArai <nobht.arai@n06ar.me>",
	"private": true,
	"version": "2.0.0",
	"packageManager": "pnpm@9.15.9",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome format . --write"
	},
	"dependencies": {
		"sanitize-html": "^2.18.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.3.4",
		"cheerio": "^1.2.0",
		"highlight.js": "^11.12.0",
		"microcms-js-sdk": "^3.6.0",
		"postcss": "^8.5.32",
		"sass": "^1.107.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"type": "module",
	"pnpm": {
		"overrides": {
			"glob@>=9.0.0 <14.0.2": ">=14.0.2",
			"minimatch@<11.0.1": ">=11.0.1"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
